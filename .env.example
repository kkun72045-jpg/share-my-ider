# Server only. Copy to .env; never put this key in extension files or VITE_ variables.
DECART_API_KEY=

# Copy the exact 32-character ID shown by chrome://extensions after loading dist/.
# Blank means extension requests are denied; wildcards are not supported.
ALLOWED_EXTENSION_ID=

# Optional personal remote access, separate from DECART_API_KEY.
# Generate a random token: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# 32-256 characters. When set, BOTH /health and /api/token require Authorization: Bearer <token>.
# Never expose the default unauthenticated broker through a public proxy.
BROKER_ACCESS_TOKEN=

# Optional comma-separated exact mobile extension origins. Requires BROKER_ACCESS_TOKEN.
# Use the actual browser Origin UUID, not a Firefox add-on ID or Safari bundle identifier.
# Example: moz-extension://12345678-abcd-4321-bcde-123456789abc,safari-web-extension://ABCDEF01-2345-6789-ABCD-EF0123456789
# No wildcard, null, website origin, port, path, or trailing slash is accepted.
ALLOWED_EXTENSION_ORIGINS=

# Optional explicit local Vite preview origin. Leave blank for extension-only use.
# DEV_ORIGIN=http://127.0.0.1:5173
DEV_ORIGIN=

# Always listens on 127.0.0.1. A user-managed HTTPS proxy must forward Host as 127.0.0.1:<PORT>.
# No HTTPS service, certificate, mobile signing, or deployment is supplied by this configuration.
PORT=8787
